#
# Bug#120923 Wrong result with CTE, UNION ALL, GROUP BY, and COUNT()
#
CREATE TABLE a (b INT);
# Original input and equivalent view
INSERT INTO a VALUES (1), (NULL);
WITH cte AS (
SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
c
0
2
PREPARE stmt FROM
'WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c';
EXECUTE stmt;
c
0
2
EXECUTE stmt;
c
0
2
CREATE VIEW v0 AS SELECT b AS c FROM a UNION ALL SELECT b FROM a;
SELECT c FROM v0 WHERE c = 0
UNION
SELECT COUNT(c) FROM v0 GROUP BY c;
c
0
2
DROP VIEW v0;
# Duplicate, distinct and NULL values
TRUNCATE TABLE a;
INSERT INTO a VALUES (1), (1), (2), (NULL), (0);
WITH cte AS (
SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
c
0
2
4
EXECUTE stmt;
c
0
2
4
EXECUTE stmt;
c
0
2
4
# Only NULL values
TRUNCATE TABLE a;
INSERT INTO a VALUES (NULL), (NULL);
WITH cte AS (
SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
c
0
EXECUTE stmt;
c
0
EXECUTE stmt;
c
0
# Empty input
TRUNCATE TABLE a;
WITH cte AS (
SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
c
EXECUTE stmt;
c
EXECUTE stmt;
c
DEALLOCATE PREPARE stmt;
#
# Shared CTE ORDER BY with LIMIT must retain the required sort
#
TRUNCATE TABLE a;
INSERT INTO a VALUES (1), (2), (0);
ANALYZE TABLE a;
# ASC ordering and repeated prepared execution
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 0
UNION
(SELECT b FROM cte ORDER BY b ASC LIMIT 1);
b
0
PREPARE stmt FROM
'WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 0
UNION
(SELECT b FROM cte ORDER BY b ASC LIMIT 1)';
EXECUTE stmt;
b
0
EXECUTE stmt;
b
0
DEALLOCATE PREPARE stmt;
# DESC ordering and repeated prepared execution
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 2
UNION
(SELECT b FROM cte ORDER BY b DESC LIMIT 1);
b
2
PREPARE stmt FROM
'WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 2
UNION
(SELECT b FROM cte ORDER BY b DESC LIMIT 1)';
EXECUTE stmt;
b
2
EXECUTE stmt;
b
2
DEALLOCATE PREPARE stmt;
#
# DISTINCT with ordered LIMIT must preserve sort feasibility
#
INSERT INTO a VALUES (NULL);
# ASC distinct values from a duplicated, shared CTE
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT DISTINCT b FROM cte
WHERE EXISTS (SELECT 1 FROM cte AS seed WHERE seed.b = 0)
ORDER BY b ASC LIMIT 2;
b
NULL
0
# DESC distinct values from a duplicated, shared CTE
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT DISTINCT b FROM cte
WHERE EXISTS (SELECT 1 FROM cte AS seed WHERE seed.b = 0)
ORDER BY b DESC LIMIT 2;
b
2
1
DROP TABLE a;
#
# Bug#120842 Wrong result with CTE, DISTINCT, NULL vs empty string,
# GROUP_CONCAT() and UNION
#
CREATE TABLE t0 (c0 CHAR(1), c3 INT);
# Original input and equivalent view
INSERT INTO t0 VALUES ('', 1), ('', 0), (NULL, 1);
WITH cte AS (
SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
gk0	gc
0	0
1	1,1
PREPARE stmt FROM
'WITH cte AS (
  SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '''' GROUP BY gk0';
EXECUTE stmt;
gk0	gc
0	0
1	1,1
EXECUTE stmt;
gk0	gc
0	0
1	1,1
CREATE VIEW v0 AS SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0;
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM v0
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM v0
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
gk0	gc
0	0
1	1,1
DROP VIEW v0;
# Duplicate, NULL and empty-string values
TRUNCATE TABLE t0;
INSERT INTO t0 VALUES
('x', 2), ('', 1), ('', 0), (NULL, 2), (NULL, 1), ('', NULL), ('', 0);
WITH cte AS (
SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
gk0	gc
0	0
1	1,1
2	2,2
NULL	NULL
EXECUTE stmt;
gk0	gc
0	0
1	1,1
2	2,2
NULL	NULL
EXECUTE stmt;
gk0	gc
0	0
1	1,1
2	2,2
NULL	NULL
# Empty input
TRUNCATE TABLE t0;
WITH cte AS (
SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
gk0	gc
EXECUTE stmt;
gk0	gc
EXECUTE stmt;
gk0	gc
DEALLOCATE PREPARE stmt;
DROP TABLE t0;
#
# Bug#120845 Wrong result with CTE, nested STDDEV_POP(),
# GROUP BY and UNION
#
CREATE TABLE a (d INT, e INT);
# Original input and equivalent view
INSERT INTO a VALUES (0, 0), (NULL, NULL), (3, 0);
WITH cte AS (
SELECT d AS f, STDDEV_POP(e) AS g FROM a GROUP BY f
)
SELECT g, f FROM cte WHERE g = 0
UNION
SELECT g, STDDEV_POP(f) FROM cte GROUP BY g;
g	f
0	0
0	1.5
0	3
NULL	NULL
PREPARE stmt FROM
'WITH cte AS (
  SELECT d AS f, STDDEV_POP(e) AS g FROM a GROUP BY f
)
SELECT g, f FROM cte WHERE g = 0
UNION
SELECT g, STDDEV_POP(f) FROM cte GROUP BY g';
EXECUTE stmt;
g	f
0	0
0	1.5
0	3
NULL	NULL
EXECUTE stmt;
g	f
0	0
0	1.5
0	3
NULL	NULL
CREATE VIEW v0 AS
SELECT d AS f, STDDEV_POP(e) AS g FROM a GROUP BY f;
SELECT g, f FROM v0 WHERE g = 0
UNION
SELECT g, STDDEV_POP(f) FROM v0 GROUP BY g;
g	f
0	0
0	1.5
0	3
NULL	NULL
DROP VIEW v0;
# Grouping followed by ordering an aggregate in a UNION arm
WITH cte AS (
SELECT d AS f, STDDEV_POP(e) AS g FROM a GROUP BY f
)
SELECT g, f FROM cte WHERE g = 0
UNION
(SELECT g, STDDEV_POP(f) FROM cte GROUP BY g
ORDER BY STDDEV_POP(f) LIMIT 100);
g	f
0	0
0	1.5
0	3
NULL	NULL
